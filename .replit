run = "pip install -q -r requirements.txt && HOST=0.0.0.0 python src/main.py"
entrypoint = "src/main.py"
modules = ["python-3.11"]

[nix]
channel = "stable-24_05"
packages = ["glibcLocales"]

[deployment]
run = ["sh", "-c", "pip install -q -r requirements.txt && HOST=0.0.0.0 python src/main.py"]

[[ports]]
localPort = 5000
externalPort = 80
