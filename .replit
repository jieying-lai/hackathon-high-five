run = "HOST=0.0.0.0 HR_INTERVIEW_PROVIDER=rules python src/main.py"
entrypoint = "src/main.py"
modules = ["python-3.11", "nodejs-24"]

[nix]
channel = "stable-24_05"
packages = ["glibcLocales"]

[deployment]
run = ["sh", "-c", "pip install -q -r requirements-web.txt && HR_INTERVIEW_PROVIDER=rules HOST=0.0.0.0 python scripts/serve_web.py"]
deploymentTarget = "gce"
ignorePorts = false

[[ports]]
localPort = 5000
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "HOST=0.0.0.0 HR_INTERVIEW_PROVIDER=rules python src/main.py"
waitForPort = 5000
