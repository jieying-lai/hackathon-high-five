# Copy this file to .env (local) or add these to Replit Secrets.
# Never commit your real .env file.
PROJECT_NAME="Project Name"
RUNPOD_API_KEY=your-runpod-api-key
RUNPOD_ENDPOINT_ID=your-endpoint-id

# Private Vault: set via shell environment or Replit Secrets.
# Set security/runtime settings in the process environment; AI settings also support .env.
# Generate a unique random value; never use the example text as a key.
FLASK_SECRET_KEY=
CAREERLENS_DEMO=1
# Enable only when served over HTTPS. Keep 0 for local HTTP preview.
COOKIE_SECURE=0
# Replit deployment: HOST=0.0.0.0; local preview defaults to 127.0.0.1.
HOST=127.0.0.1
GEMINI_API_KEY=
QUESTIONNAIRE_GEMINI_MODEL=gemini-2.5-flash

QUESTIONNAIRE_PROVIDER=local

# Interview-question model connector. No automatic template/question-bank fallback.
HR_INTERVIEW_PROVIDER=local
HR_INTERVIEW_MODEL_URL=http://127.0.0.1:8766/generate
